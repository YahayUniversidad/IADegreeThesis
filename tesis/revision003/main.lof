\contentsline {figure}{\numberline {A.2}{\ignorespaces Dashboard de análisis dimensional por riesgo y sector.}}{51}{figure.caption.40}%
\contentsline {figure}{\numberline {A.3}{\ignorespaces Dashboard de evolución temporal de predicciones.}}{52}{figure.caption.41}%
\contentsline {figure}{\numberline {A.4}{\ignorespaces Esquema estrella de la tabla \texttt {fact\_creditos\_mensual}. Almacena los agregados históricos de créditos por bloque-mes, incluyendo la variable objetivo \texttt {crisis\_flag}.}}{52}{figure.caption.42}%
\contentsline {figure}{\numberline {A.5}{\ignorespaces Esquema estrella de la tabla \texttt {fact\_predicciones}. Almacena las probabilidades y predicciones binarias para los 18 horizontes temporales, generadas por el modelo seleccionado.}}{53}{figure.caption.43}%
