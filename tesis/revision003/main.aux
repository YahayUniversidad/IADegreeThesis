\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces Matriz de correlaciones de Pearson entre las 21 características numéricas del conjunto analítico. Los valores cercanos a 1,0 (color intenso) indican alta correlación positiva. Se observa multicolinealidad severa entre pares como \texttt  {num\_creditos}--\texttt  {creditos\_cerrados} y \texttt  {monto\_total}--\texttt  {monto\_promedio}. La multicolinealidad afecta de manera diferente a modelos lineales y no lineales.}}{33}{figure.caption.24}\protected@file@percent }
\newlabel{fig:heatmap}{{5.1}{33}{Matriz de correlaciones de Pearson entre las 21 características numéricas del conjunto analítico. Los valores cercanos a 1,0 (color intenso) indican alta correlación positiva. Se observa multicolinealidad severa entre pares como \texttt {num\_creditos}--\texttt {creditos\_cerrados} y \texttt {monto\_total}--\texttt {monto\_promedio}. La multicolinealidad afecta de manera diferente a modelos lineales y no lineales}{figure.caption.24}{}}
